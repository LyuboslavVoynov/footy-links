generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Player {
  id                   String       @id @default(cuid())
  name                 String
  slug                 String       @unique
  nationality          String?
  wikidataId           String?      @unique
  imageUrl             String?
  mediaAsset           MediaAsset?
  eligibleForChallenge Boolean      @default(false)
  playerClubs          PlayerClub[]
  createdAt            DateTime     @default(now())
  updatedAt            DateTime     @updatedAt

  @@index([name])
  @@index([eligibleForChallenge])
}

model Club {
  id          String       @id @default(cuid())
  name        String
  slug        String       @unique
  country     String?
  wikidataId  String?      @unique
  imageUrl    String?
  providerTeamId Int?    @unique
  crestUrl     String?
  mediaAsset  MediaAsset?
  gameEligible Boolean     @default(false)
  playerClubs PlayerClub[]
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@index([name])
}

model MediaAsset {
  id           String   @id @default(cuid())
  playerId     String?  @unique
  clubId       String?  @unique
  kind         String
  assetUrl     String
  sourceName   String
  sourceUrl    String?
  license       String?
  attribution  String?
  rightsStatus String   @default("needs_review")
  verifiedAt   DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  player       Player?  @relation(fields: [playerId], references: [id], onDelete: Cascade)
  club         Club?    @relation(fields: [clubId], references: [id], onDelete: Cascade)

  @@index([rightsStatus])
  @@index([kind])
}

model PlayerClub {
  playerId    String
  clubId      String
  startYear   Int?
  endYear     Int?
  loan        Boolean @default(false)
  appearances Int?
  sourceName  String?
  sourceReference String?
  validatedAt DateTime?
  verificationStatus String @default("unverified")
  reviewStatus       String @default("candidate")
  reviewerNote       String?
  reviewedAt         DateTime?
  gameEligible Boolean @default(false)
  player      Player  @relation(fields: [playerId], references: [id], onDelete: Cascade)
  club        Club    @relation(fields: [clubId], references: [id], onDelete: Cascade)

  @@id([playerId, clubId])
  @@index([clubId])
  @@index([gameEligible])
  @@index([reviewStatus])
}

model IngestionBatch {
  id              String   @id @default(cuid())
  sourceName      String
  sourceReference String?
  status          String   @default("completed")
  candidateCount  Int      @default(0)
  acceptedCount   Int      @default(0)
  rejectedCount   Int      @default(0)
  createdAt       DateTime @default(now())
  processedAt     DateTime?

  @@index([sourceName])
  @@index([createdAt])
}
