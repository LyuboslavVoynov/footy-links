# PostgreSQL connection string. For Vercel, use the Supabase pooled connection string.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/football_links?schema=public"

# Required before exposing /admin/intake publicly. Never commit the real value.
INTAKE_ADMIN_PASSWORD="replace-with-a-long-unique-password"

# API-Football key for controlled candidate-pack generation. Never expose this client-side.
API_FOOTBALL_KEY=""

# football-data.org token used only by the server-side crest-sync script.
FOOTBALL_DATA_API_KEY=""
